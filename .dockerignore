# Version control
.git
.gitignore
.gitattributes

# Environment files (never bake secrets into images)
.env
.env.*
!.env.example

# Editor / IDE
.vscode
.idea
*.swp
*.swo

# CI / git hooks (not needed in container)
.github
.husky

# Node / build output
node_modules
*/node_modules
**/node_modules
dist
*/dist
**/dist
coverage
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS cruft
.DS_Store
Thumbs.db

# Docs and media (not needed for build)
*.jpeg
*.jpg
*.png
*.gif
*.tar.gz
CHANGELOG.md
README.md
LICENSE
docs

# Misc
.claude
.prettierignore
.prettierrc
.release-please-manifest.json
release-please-config.json
